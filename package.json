{
  "name": "modelharbor",
  "productName": "ModelHarbor",
  "desktopName": "modelharbor.desktop",
  "version": "1.0.1",
  "description": "Lokale KI-Chatmodelle mit einem Klick: Hardware-Erkennung, passende Modellvorschläge, HuggingFace-Download und fertige Presets.",
  "main": "electron/main.js",
  "author": "Rolf Greger",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "selftest:backend": "node scripts/selftest-backend.js",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "com.modelharbor.app",
    "productName": "ModelHarbor",
    "copyright": "Rolf Greger",
    "files": [
      "electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Lokale KI-Chatmodelle mit einem Klick",
      "syncDesktopName": true
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "tar": "^7.5.23",
    "yauzl": "^2.10.0"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "glob": {
      "minimatch": "3.1.5"
    },
    "@electron/asar": {
      "minimatch": "3.1.5"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
